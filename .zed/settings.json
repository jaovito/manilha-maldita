{
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "eslint": {
      "settings": {
        "eslint.enable": false
      }
    }
  },
  "language_servers": ["!eslint", "..."],
  "languages": {
    "JavaScript": {
      "language_servers": ["biome", "!eslint", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on"
    },
    "JSX": {
      "language_servers": ["biome", "!eslint", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on"
    },
