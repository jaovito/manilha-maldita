# Credenciais fictícias e exclusivas do Docker local. Nunca use em produção.
POSTGRES_PORT=55432
POSTGRES_PASSWORD=truco_local
POSTGRES_TEST_PORT=55433
POSTGRES_TEST_PASSWORD=truco_test_local
DATABASE_URL=postgresql://truco:truco_local@127.0.0.1:55432/truco_dev
TEST_DATABASE_URL=postgresql://truco_test:truco_test_local@127.0.0.1:55433/truco_test

# Servidor multiplayer em memória. Frontend local usa proxy /api.
# A URL pública opcional do backend fica em apps/web/.env.local; veja apps/web/.env.example.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:3001,http://localhost:5173,http://localhost:4173,http://localhost:3001
SECURE_COOKIES=false

# Flags independentes. start:server fica fechado por padrão; dev:server habilita ambas.
# ENABLE_SOLO=true permite partidas contra bot também em produção.
# ENABLE_DEV_TOOLS=true só tem efeito com NODE_ENV=development e em mesa solo.
# ENABLE_SOLO=false
# ENABLE_DEV_TOOLS=false
