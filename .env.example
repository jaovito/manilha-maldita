# Fictitious credentials for local Docker only. Never use in production.
POSTGRES_PORT=55432
POSTGRES_PASSWORD=truco_local
POSTGRES_TEST_PORT=55433
POSTGRES_TEST_PASSWORD=truco_test_local
DATABASE_URL=postgresql://truco:truco_local@127.0.0.1:55432/truco_dev
TEST_DATABASE_URL=postgresql://truco_test:truco_test_local@127.0.0.1:55433/truco_test

# In-memory multiplayer server. The local frontend uses the /api proxy.
# Optional public backend URL: apps/web/.env.local; see apps/web/.env.example.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:3001,http://localhost:5173,http://localhost:4173,http://localhost:3001
SECURE_COOKIES=false

# Independent flags. start:server disables both by default; dev:server enables both.
# ENABLE_SOLO=true also allows bot matches in production.
# ENABLE_DEV_TOOLS=true only applies to solo tables with NODE_ENV=development.
# ENABLE_SOLO=false
# ENABLE_DEV_TOOLS=false

# Account security: consumed only by explicit account composition (not guest startup).
# Generation cost and bounded verification costs, in KiB and iterations respectively.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_MAX_MEMORY_KIB=65536
ARGON2_MAX_ITERATIONS=6
PASSWORD_MAX_CONCURRENCY=2
# max verification memory * concurrency must fit this budget (128 MiB by default).
PASSWORD_MEMORY_BUDGET_KIB=131072
# Required for accounts, with no default: generate 32 random bytes as 64 lowercase hex digits.
# Store in Railway secret variables or a secret manager, separately from the database.
# Never commit a real value, expose it through VITE_, or change it without a reset plan.
# PASSWORD_PEPPER=

# Account application policy (for explicit composition; main remains guest-only).
AUTH_SESSION_TTL_MS=86400000
AUTH_ATTEMPT_WINDOW_MS=300000
AUTH_LOGIN_ATTEMPTS=5
AUTH_IP_ATTEMPTS=20
AUTH_GLOBAL_ATTEMPTS=200
